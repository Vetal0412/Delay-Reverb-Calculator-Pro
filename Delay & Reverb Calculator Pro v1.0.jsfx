  fb_mode == 1 ? (gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;) :
                 (hover_fb_mode1 ? (gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;) : (gfx_r = panel_r*1.3; gfx_g = panel_g*1.3; gfx_b = panel_b*1.3;));
  draw_rrect(210, content_y+98, 165, 26, 6);
  fb_mode == 1 ? (gfx_r = accent_hi_r; gfx_g = accent_hi_g; gfx_b = accent_b_hi; gfx_a = 0.35;
                  gfx_rect(floor(offset_x+216*scale), floor(offset_y+content_y+100*scale), floor(153*scale), 1, 1); gfx_a = 1;)
               : (draw_bevel(210, content_y+98, 165, 26, 4));
  #str_tmp = "Tail -> Feedback";
  fb_mode == 1 ? text_center_c(210, content_y+98, 165, 26, #str_tmp, 12, 0.05, 0.05, 0.05) :
                 text_center(210, content_y+98, 165, 26, #str_tmp, 12);

  #str_tmp = "THRESHOLD"; text_muted(35, content_y+132, #str_tmp, 11);
  th_y = content_y+145; thr_w = 90; thr_h = 22;

  hover_thr40 = (my >= 354) && (mx >= 35  && mx <= 125 && my >= th_y && my <= th_y+thr_h);
  hover_thr50 = (my >= 354) && (mx >= 135 && mx <= 225 && my >= th_y && my <= th_y+thr_h);
  hover_thr60 = (my >= 354) && (mx >= 235 && mx <= 325 && my >= th_y && my <= th_y+thr_h);
  hover_thr70 = (my >= 354) && (mx >= 335 && mx <= 425 && my >= th_y && my <= th_y+thr_h);

  fb_threshold == -40 ? (gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;) : (hover_thr40 ? (gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;) : (gfx_r = panel_r*1.3; gfx_g = panel_g*1.3; gfx_b = panel_b*1.3;));
  draw_rrect(35, th_y, thr_w, thr_h, 5);
  fb_threshold == -40 ? (gfx_r = accent_hi_r; gfx_g = accent_hi_g; gfx_b = accent_b_hi; gfx_a = 0.35;
                         gfx_rect(floor(offset_x+41*scale), floor(offset_y+th_y+2*scale), floor((thr_w-12)*scale), 1, 1); gfx_a = 1;)
                      : (draw_bevel(35, th_y, thr_w, thr_h, 4));
  #str_tmp = "-40 dB"; fb_threshold == -40 ? text_center_c(35, th_y, thr_w, thr_h, #str_tmp, 12, 0.05, 0.05, 0.05) : text_center(35, th_y, thr_w, thr_h, #str_tmp, 12);

  fb_threshold == -50 ? (gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;) : (hover_thr50 ? (gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;) : (gfx_r = panel_r*1.3; gfx_g = panel_g*1.3; gfx_b = panel_b*1.3;));
  draw_rrect(135, th_y, thr_w, thr_h, 5);
  fb_threshold == -50 ? (gfx_r = accent_hi_r; gfx_g = accent_hi_g; gfx_b = accent_b_hi; gfx_a = 0.35;
                         gfx_rect(floor(offset_x+141*scale), floor(offset_y+th_y+2*scale), floor((thr_w-12)*scale), 1, 1); gfx_a = 1;)
                      : (draw_bevel(135, th_y, thr_w, thr_h, 4));
  #str_tmp = "-50 dB"; fb_threshold == -50 ? text_center_c(135, th_y, thr_w, thr_h, #str_tmp, 12, 0.05, 0.05, 0.05) : text_center(135, th_y, thr_w, thr_h, #str_tmp, 12);

  fb_threshold == -60 ? (gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;) : (hover_thr60 ? (gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;) : (gfx_r = panel_r*1.3; gfx_g = panel_g*1.3; gfx_b = panel_b*1.3;));
  draw_rrect(235, th_y, thr_w, thr_h, 5);
  fb_threshold == -60 ? (gfx_r = accent_hi_r; gfx_g = accent_hi_g; gfx_b = accent_b_hi; gfx_a = 0.35;
                         gfx_rect(floor(offset_x+241*scale), floor(offset_y+th_y+2*scale), floor((thr_w-12)*scale), 1, 1); gfx_a = 1;)
                      : (draw_bevel(235, th_y, thr_w, thr_h, 4));
  #str_tmp = "-60 dB"; fb_threshold == -60 ? text_center_c(235, th_y, thr_w, thr_h, #str_tmp, 12, 0.05, 0.05, 0.05) : text_center(235, th_y, thr_w, thr_h, #str_tmp, 12);

  fb_threshold == -70 ? (gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;) : (hover_thr70 ? (gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;) : (gfx_r = panel_r*1.3; gfx_g = panel_g*1.3; gfx_b = panel_b*1.3;));
  draw_rrect(335, th_y, thr_w, thr_h, 5);
  fb_threshold == -70 ? (gfx_r = accent_hi_r; gfx_g = accent_hi_g; gfx_b = accent_b_hi; gfx_a = 0.35;
                         gfx_rect(floor(offset_x+341*scale), floor(offset_y+th_y+2*scale), floor((thr_w-12)*scale), 1, 1); gfx_a = 1;)
                      : (draw_bevel(335, th_y, thr_w, thr_h, 4));
  #str_tmp = "-70 dB"; fb_threshold == -70 ? text_center_c(335, th_y, thr_w, thr_h, #str_tmp, 12, 0.05, 0.05, 0.05) : text_center(335, th_y, thr_w, thr_h, #str_tmp, 12);

  #str_tmp = "-60 dB approx 0.1% amplitude"; text_muted(450, th_y+6, #str_tmp, 11);

  #str_tmp = "DAMPING PROFILE"; text_muted(35, content_y+175, #str_tmp, 11);
  dp_y = content_y+188; dp_w = 180; dp_h = 22;

  hover_dmp0 = (my >= 354) && (mx >= 35  && mx <= 215 && my >= dp_y && my <= dp_y+dp_h);
  hover_dmp1 = (my >= 354) && (mx >= 225 && mx <= 405 && my >= dp_y && my <= dp_y+dp_h);
  hover_dmp2 = (my >= 354) && (mx >= 415 && mx <= 595 && my >= dp_y && my <= dp_y+dp_h);

  fb_damping_mode == 0 ? (gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;) : (hover_dmp0 ? (gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;) : (gfx_r = panel_r*1.3; gfx_g = panel_g*1.3; gfx_b = panel_b*1.3;));
  draw_rrect(35, dp_y, dp_w, dp_h, 5);
  fb_damping_mode == 0 ? (gfx_r = accent_hi_r; gfx_g = accent_hi_g; gfx_b = accent_b_hi; gfx_a = 0.35;
                          gfx_rect(floor(offset_x+41*scale), floor(offset_y+dp_y+2*scale), floor((dp_w-12)*scale), 1, 1); gfx_a = 1;)
                       : (draw_bevel(35, dp_y, dp_w, dp_h, 4));
  #str_tmp = "Ideal (x1.00)"; fb_damping_mode == 0 ? text_center_c(35, dp_y, dp_w, dp_h, #str_tmp, 12, 0.05, 0.05, 0.05) : text_center(35, dp_y, dp_w, dp_h, #str_tmp, 12);

  fb_damping_mode == 1 ? (gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;) : (hover_dmp1 ? (gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;) : (gfx_r = panel_r*1.3; gfx_g = panel_g*1.3; gfx_b = panel_b*1.3;));
  draw_rrect(225, dp_y, dp_w, dp_h, 5);
  fb_damping_mode == 1 ? (gfx_r = accent_hi_r; gfx_g = accent_hi_g; gfx_b = accent_b_hi; gfx_a = 0.35;
                          gfx_rect(floor(offset_x+231*scale), floor(offset_y+dp_y+2*scale), floor((dp_w-12)*scale), 1, 1); gfx_a = 1;)
                       : (draw_bevel(225, dp_y, dp_w, dp_h, 4));
  #str_tmp = "Mild (x0.85)"; fb_damping_mode == 1 ? text_center_c(225, dp_y, dp_w, dp_h, #str_tmp, 12, 0.05, 0.05, 0.05) : text_center(225, dp_y, dp_w, dp_h, #str_tmp, 12);

  fb_damping_mode == 2 ? (gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;) : (hover_dmp2 ? (gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;) : (gfx_r = panel_r*1.3; gfx_g = panel_g*1.3; gfx_b = panel_b*1.3;));
  draw_rrect(415, dp_y, dp_w, dp_h, 5);
