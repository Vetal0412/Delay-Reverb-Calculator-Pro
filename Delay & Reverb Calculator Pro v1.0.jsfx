    #str_tmp = "The time signature determines how many quarter-note equivalents are contained in one bar."; text_muted(40, 167, #str_tmp, 13);
    #str_tmp = "4/4 = 4 quarter-note equivalents. 3/4 = 3. 6/8 = 3. 12/8 = 6."; text_muted(40, 187, #str_tmp, 13);
    #str_tmp = "Presets: March 2/4, Waltz 3/4, Common 4/4, Five Four 5/4, Six Eight 6/8, Seven Eight 7/8, Nine Eight 9/8, Twelve Eight 12/8."; text_muted(40, 207, #str_tmp, 13);
    #str_tmp = "In Manual mode, numerator and denominator can be entered separately. Supported range: 1–16."; text_muted(40, 227, #str_tmp, 13);
