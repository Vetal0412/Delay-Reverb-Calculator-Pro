    #str_tmp = "60 BPM = 1000 мс на чверть. 120 BPM = 500 мс. 140 BPM = приблизно 428.57 мс."; text_muted(40, 327, #str_tmp, 13);
    #str_tmp = "Зміна BPM змінює тривалості нот, таймінг ревербу та перерахунок у долі й такти."; text_muted(40, 347, #str_tmp, 13);
    #str_tmp = "Діапазон Manual BPM: 20–300 BPM. Значення за межами діапазону обмежуються підтримуваним діапазоном."; text_muted(40, 367, #str_tmp, 13);
    #str_tmp = "Для редагування BPM натисніть на значення, введіть число та натисніть Enter."; text_muted(40, 387, #str_tmp, 13);
