  #str_tmp = "1/32";  note_row(content_y+172, #str_tmp, quarter*0.125,    quarter*0.1875,   quarter/12,          1);
  #str_tmp = "1/64";  note_row(content_y+200, #str_tmp, quarter*0.0625,   quarter*0.09375,  quarter/24,          0);
  #str_tmp = "1/128"; note_row(content_y+228, #str_tmp, quarter*0.03125,  quarter*0.046875, quarter/48,          1);
  #str_tmp = "1/256"; note_row(content_y+256, #str_tmp, quarter*0.015625, quarter*0.0234375,quarter/96,          0);
  #str_tmp = "1/512"; note_row(content_y+284, #str_tmp, quarter*0.0078125,quarter*0.01171875,quarter/192,        1);
) : (
  panel(15, content_y+10, 755, 55);
  #str_tmp = "DELAY TIME"; text_muted(35, content_y+18, #str_tmp, 11);

  hover_fb_delay = (my >= 354) && (mx >= 35 && mx <= 365 && my >= content_y+30 && my <= content_y+58);
  gfx_a = 1;
  (fb_edit_field == 1) ? (gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;) :
  (hover_fb_delay ? (gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;) : (gfx_r = panel_r*1.3; gfx_g = panel_g*1.3; gfx_b = panel_b*1.3;));
  draw_rrect(35, content_y+30, 330, 26, 6);

  fb_edit_field == 1 ? (
