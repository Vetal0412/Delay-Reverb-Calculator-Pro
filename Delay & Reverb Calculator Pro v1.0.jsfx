desc: Delay & Reverb Calculator Pro v1.0

slider1:120<20,300,0.01>-BPM
slider2:0<0,2,1{ms,s,Hz}>-Display Unit
slider3:0<0,1,1{Manual,Sync}>-Tempo Sync Mode
slider4:0<0,3,1{Charcoal,Emerald,Graphite,Ocean}>-Color Theme
slider5:0<0,2,1{Reverb,Notes,DelayTail}>-Active Tab
slider6:2<0,3,1{-40,-50,-60,-70}>-Threshold
slider7:0<0,2,1{Ideal,Mild,Strong}>-Damping Profile
slider8:4<1,16,1>-Time Sig Numerator
slider9:4<1,16,1>-Time Sig Denominator

@init
ext_noinit = 1;

bpm = 120; manual_bpm = 120; edit_bpm = 0; sync_mode = 0; theme = 0; got_slider = 0;
active_tab = 0; scroll_y = 0; prev_wheel = 0;
show_ts_menu = 0; show_custom_menu = 0; show_help = 0;
help_lang = 0; help_scroll = 0; help_wheel = 0;
cur_ts_num = 4; cur_ts_den = 4; manual_ts_num = 4; manual_ts_den = 4; edit_ts = 0;

fb_mode = 0; fb_damping_mode = 0; fb_delay_ms = 375; fb_feedback_pct = 50;
fb_tail_target = 3.0; fb_threshold = -60; fb_threshold_idx = 2; fb_edit_field = 0;
fb_calc_tail = 0; fb_calc_repeats = 0; fb_calc_feedback = 0; fb_db_val = 0;
tail_beats = 0; tail_bars = 0; last_rep = 0;

focus_lockout = 0; prev_hasfocus = 1;

base_w = 785; base_h = 670; scale = 1;
bg_r = 0.025; bg_g = 0.035; bg_b = 0.030;
panel_r = 0.078; panel_g = 0.105; panel_b = 0.092;
line_r = 0.160; line_g = 0.220; line_b = 0.190;
text_r = 0.840; text_g = 0.880; text_b = 0.850;
muted_r = 0.460; muted_g = 0.520; muted_b = 0.490;
accent_r = 0.450; accent_g = 0.780; accent_b = 0.570;
accent_hi_r = 0.620; accent_hi_g = 0.920; accent_b_hi = 0.700;

tap_i0 = 0; tap_i1 = 0; tap_i2 = 0; tap_i3 = 0; tap_i4 = 0; tap_i5 = 0; tap_n = 0;
fbn_best_row = 0; fbn_best_col = 0; fbn_best_ms = 0;
fbn_best_diff = 0; fbn_best_mult = 0; custom_ms = 0;

reverb_pre[0] = 1/16; reverb_pre[1] = 1/32; reverb_pre[2] = 1/32;
reverb_pre[3] = 1/64; reverb_pre[4] = 1/128; reverb_pre[5] = 1/256;
reverb_pre[6] = 1/512; reverb_pre[7] = 1/1024; reverb_pre[8] = 1/2048;
reverb_bars[0] = 4; reverb_bars[1] = 3; reverb_bars[2] = 2;
reverb_bars[3] = 1; reverb_bars[4] = 3/4; reverb_bars[5] = 1/2;
reverb_bars[6] = 3/8; reverb_bars[7] = 1/4; reverb_bars[8] = 1/8;

#bpm_string = ""; #bpm_display = ""; #digit = ""; #tmp = ""; #out = "";
#unit_text = ""; #ts = ""; #ts_info = "";
#ts_num_str = ""; #ts_den_str = "";
#ts_num_digit = ""; #ts_den_digit = "";
#ts_num_tmp = ""; #ts_den_tmp = "";
#theme_name = "";
#n1 = ""; #n2 = ""; #n3 = "";
#r1 = ""; #r2 = ""; #r3 = "";
#bars_label = ""; #tap_label = ""; #taps_count = "";
#custom_string = ""; #custom_digit = ""; #custom_tmp = "";
#note_name = ""; #note_base = ""; #note_suffix = "";
#fb_buf = ""; #fb_tmp = ""; #fb_out = "";
#str_tmp = "";
#help_lang_label = "";
#help_close = "";

tap_last = 0; last_mouse_cap = 0; last_mid_cap = 0; last_right_cap = 0; unit = 0;

qr_size = 25;
qr_rows[0]  = 0x1FD267F;
qr_rows[1]  = 0x1055141;
qr_rows[2]  = 0x175D65D;
qr_rows[3]  = 0x175CD5D;
qr_rows[4]  = 0x174AB5D;
qr_rows[5]  = 0x105C141;
qr_rows[6]  = 0x1FD557F;
qr_rows[7]  = 0x0007000;
qr_rows[8]  = 0x19C422F;
qr_rows[9]  = 0x082271A;
qr_rows[10] = 0x1B6F27C;
qr_rows[11] = 0x1099556;
qr_rows[12] = 0x1D6306F;
qr_rows[13] = 0x1096B12;
qr_rows[14] = 0x03E777C;
qr_rows[15] = 0x06A8036;
qr_rows[16] = 0x1B443FC;
qr_rows[17] = 0x0016D10;
qr_rows[18] = 0x1FC3150;
qr_rows[19] = 0x105271F;
qr_rows[20] = 0x17531FE;
qr_rows[21] = 0x174E6E7;
qr_rows[22] = 0x174F6CA;
qr_rows[23] = 0x105223E;
qr_rows[24] = 0x1FDF207;

hover_tap = 0; hover_ms = 0; hover_s = 0; hover_hz = 0;
hover_ts = 0; hover_sync = 0; hover_theme = 0; hover_help = 0;
hover_tab1 = 0; hover_tab2 = 0; hover_tab3 = 0;
hover_custom = 0; tap_press = 0;
hover_fb_delay = 0; hover_fb_input = 0;
hover_fb_mode0 = 0; hover_fb_mode1 = 0;
hover_thr40 = 0; hover_thr50 = 0; hover_thr60 = 0; hover_thr70 = 0;
hover_dmp0 = 0; hover_dmp1 = 0; hover_dmp2 = 0;
hover_help_lang = 0; hover_help_close = 0;

function apply_theme()
(
  theme == 0 ? (
    bg_r = 0.180; bg_g = 0.190; bg_b = 0.200;
    panel_r = 0.120; panel_g = 0.130; panel_b = 0.140;
    line_r = 0.280; line_g = 0.300; line_b = 0.320;
    text_r = 0.900; text_g = 0.920; text_b = 0.930;
    muted_r = 0.560; muted_g = 0.590; muted_b = 0.610;
    accent_r = 0.380; accent_g = 0.820; accent_b = 0.680;
    accent_hi_r = 0.560; accent_hi_g = 0.960; accent_b_hi = 0.830;
    #theme_name = "Charcoal";
  );
  theme == 1 ? (
    bg_r = 0.025; bg_g = 0.040; bg_b = 0.033;
    panel_r = 0.078; panel_g = 0.105; panel_b = 0.092;
    line_r = 0.160; line_g = 0.220; line_b = 0.190;
    text_r = 0.840; text_g = 0.880; text_b = 0.850;
    muted_r = 0.460; muted_g = 0.520; muted_b = 0.490;
    accent_r = 0.450; accent_g = 0.780; accent_b = 0.570;
    accent_hi_r = 0.620; accent_hi_g = 0.920; accent_b_hi = 0.700;
    #theme_name = "Emerald";
  );
  theme == 2 ? (
    bg_r = 0.030; bg_g = 0.033; bg_b = 0.045;
    panel_r = 0.090; panel_g = 0.100; panel_b = 0.120;
    line_r = 0.170; line_g = 0.190; line_b = 0.230;
    text_r = 0.850; text_g = 0.880; text_b = 0.920;
    muted_r = 0.480; muted_g = 0.510; muted_b = 0.560;
    accent_r = 0.380; accent_g = 0.650; accent_b = 0.980;
    accent_hi_r = 0.580; accent_hi_g = 0.800; accent_b_hi = 1.000;
    #theme_name = "Graphite";
  );
  theme == 3 ? (
    bg_r = 0.015; bg_g = 0.035; bg_b = 0.065;
    panel_r = 0.035; panel_g = 0.075; panel_b = 0.130;
    line_r = 0.090; line_g = 0.170; line_b = 0.280;
    text_r = 0.820; text_g = 0.900; text_b = 0.950;
    muted_r = 0.460; muted_g = 0.580; muted_b = 0.660;
    accent_r = 0.280; accent_g = 0.680; accent_b = 0.950;
    accent_hi_r = 0.480; accent_hi_g = 0.830; accent_b_hi = 1.000;
    #theme_name = "Ocean";
  );
);
apply_theme();

function draw_kofi_qr(start_x, start_y, module_size)
(
  quiet_zone = 4;
  total_modules = qr_size + quiet_zone*2;
  px = module_size;
  // solid white background with quiet zone
  gfx_a = 1; gfx_r = 1; gfx_g = 1; gfx_b = 1;
  bx = floor(offset_x + (start_x - quiet_zone*px)*scale);
  by = floor(offset_y + (start_y - quiet_zone*px)*scale);
  bw = floor(total_modules*px*scale) + 2;
  bh = floor(total_modules*px*scale) + 2;
  gfx_rect(bx, by, bw, bh, 1);

  // draw modules with slight overlap to eliminate gaps at fractional scale
  gfx_r = 0; gfx_g = 0; gfx_b = 0;
  r = 0;
  loop(qr_size,
    mask = qr_rows[r];
    c = 0;
    loop(qr_size,
      ((mask >> (qr_size - 1 - c)) & 1) ? (
        mx = floor(offset_x + (start_x + c*px)*scale);
        my = floor(offset_y + (start_y + r*px)*scale);
        mw = floor((c+1)*px*scale) - floor(c*px*scale) + 1;
        mh = floor((r+1)*px*scale) - floor(r*px*scale) + 1;
        gfx_rect(mx, my, mw, mh, 1);
      );
      c += 1;
    );
    r += 1;
  );
);

function format_time(value)
(
  unit == 0 ? (sprintf(#out, "%.2f", value););
  unit == 1 ? (sprintf(#out, "%.3f", value/1000););
  unit == 2 ? (value > 0 ? sprintf(#out, "%.3f", 1000/value) : sprintf(#out, "0.000"););
);

function unit_name()
(
  unit == 0 ? (#unit_text = "ms") :
  unit == 1 ? (#unit_text = "s") :
              (#unit_text = "Hz");
);

function set_font(size)
(
  sz = floor(size*scale);
  sz < 8 ? sz = 8;
  gfx_setfont(1, "Arial", sz);
);

function draw_rrect(x, y, w, h, r)
(
  x = floor(offset_x + x*scale);
  y = floor(offset_y + y*scale);
  w = floor(w*scale);
  h = floor(h*scale);
  r = floor(r*scale);
  r < 1 ? (
    gfx_rect(x, y, w, h, 1);
  ) : (
    gfx_rect(x+r, y, w-2*r, h, 1);
    gfx_rect(x, y+r, r, h-2*r, 1);
    gfx_rect(x+w-r, y+r, r, h-2*r, 1);
    gfx_circle(x+r, y+r, r, 1);
    gfx_circle(x+w-r-1, y+r, r, 1);
    gfx_circle(x+r, y+h-r-1, r, 1);
    gfx_circle(x+w-r-1, y+h-r-1, r, 1);
  );
);

function draw_bevel(x, y, w, h, inset)
(
  ix = x + inset;
  iw = w - 2*inset;
  gfx_a = 0.12; gfx_r = 1; gfx_g = 1; gfx_b = 1;
  gfx_rect(floor(offset_x+ix*scale), floor(offset_y+(y+1)*scale), floor(iw*scale), 1, 1);
  gfx_a = 0.30; gfx_r = 0; gfx_g = 0; gfx_b = 0;
  gfx_rect(floor(offset_x+ix*scale), floor(offset_y+(y+h-2)*scale), floor(iw*scale), 1, 1);
  gfx_a = 1;
);

function panel(x, y, w, h)
(
  gfx_a = 0.10; gfx_r = 0; gfx_g = 0; gfx_b = 0; draw_rrect(x, y+3, w, h, 10);
  gfx_a = 0.05; draw_rrect(x-1, y+5, w+2, h+2, 12);
  gfx_a = 1; gfx_r = panel_r; gfx_g = panel_g; gfx_b = panel_b; draw_rrect(x, y, w, h, 10);
  gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.10;
  gfx_rect(floor(offset_x+(x+12)*scale), floor(offset_y+(y+1)*scale), floor((w-24)*scale), 1, 1);
  gfx_a = 1; gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 0.18;
  gfx_rect(floor(offset_x+(x+12)*scale), floor(offset_y+(y+h-1)*scale), floor((w-24)*scale), 1, 1);
  gfx_a = 1;
);

function text_left(x, y, txt, size)
(
  gfx_a = 1; gfx_r = text_r; gfx_g = text_g; gfx_b = text_b; set_font(size);
  gfx_x = floor(offset_x + x*scale);
  gfx_y = floor(offset_y + y*scale);
  gfx_drawstr(txt);
);

function text_muted(x, y, txt, size)
(
  gfx_a = 1; gfx_r = muted_r; gfx_g = muted_g; gfx_b = muted_b; set_font(size);
  gfx_x = floor(offset_x + x*scale);
  gfx_y = floor(offset_y + y*scale);
  gfx_drawstr(txt);
);

function text_center(x, y, w, h, txt, size)
(
  gfx_a = 1; set_font(size); gfx_measurestr(txt, tw, th);
  gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
  gfx_x = floor(offset_x + (x+w/2)*scale - tw/2);
  gfx_y = floor(offset_y + (y+h/2)*scale - th/2);
  gfx_drawstr(txt);
);

function text_center_c(x, y, w, h, txt, size, cr, cg, cb)
(
  gfx_a = 1; set_font(size); gfx_measurestr(txt, tw, th);
  gfx_r = cr; gfx_g = cg; gfx_b = cb;
  gfx_x = floor(offset_x + (x+w/2)*scale - tw/2);
  gfx_y = floor(offset_y + (y+h/2)*scale - th/2);
  gfx_drawstr(txt);
);

function cell_label(x, y, w, h, txt, highlight)
(
  gfx_a = 1; gfx_r = panel_r*0.7; gfx_g = panel_g*0.7; gfx_b = panel_b*0.7;
  gfx_rect(floor(offset_x+x*scale), floor(offset_y+y*scale), floor(w*scale), floor(h*scale), 1);
  highlight ? (
    gfx_a = 1; gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;
    gfx_rect(floor(offset_x+x*scale), floor(offset_y+y*scale), floor(w*scale), floor(h*scale), 1);
  );
  gfx_a = 1; gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;
  gfx_rect(floor(offset_x+x*scale), floor(offset_y+y*scale), floor(w*scale), floor(h*scale), 0);
  set_font(17); gfx_a = 1; gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
  gfx_measurestr(txt, tw, th);
  gfx_x = floor(offset_x + (x+w/2)*scale - tw/2);
  gfx_y = floor(offset_y + (y+h/2)*scale - th/2);
  gfx_drawstr(txt);
);

function cell_value(x, y, w, h, val_str, unit_str, highlight)
(
  gfx_a = 1; gfx_r = panel_r*0.7; gfx_g = panel_g*0.7; gfx_b = panel_b*0.7;
  gfx_rect(floor(offset_x+x*scale), floor(offset_y+y*scale), floor(w*scale), floor(h*scale), 1);
  highlight ? (
    gfx_a = 1; gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;
    gfx_rect(floor(offset_x+x*scale), floor(offset_y+y*scale), floor(w*scale), floor(h*scale), 1);
  );
  gfx_a = 1; gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;
  gfx_rect(floor(offset_x+x*scale), floor(offset_y+y*scale), floor(w*scale), floor(h*scale), 0);

  u_len = strlen(unit_str);

  u_len > 0 ? (
    set_font(17); gfx_measurestr(val_str, tw, th);
    set_font(12); gfx_measurestr(unit_str, tw_u, th_u);
    gap = 5;
    total_w = tw + gap*scale + tw_u;
    start_x = floor(offset_x + (x + w/2)*scale - total_w/2);
    val_y = floor(offset_y + (y + h/2)*scale - th/2);

    set_font(17); gfx_a = 1; gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
    gfx_x = start_x; gfx_y = val_y;
    gfx_drawstr(val_str);

    set_font(12); gfx_a = 1; gfx_r = muted_r; gfx_g = muted_g; gfx_b = muted_b;
    gfx_x = floor(start_x + tw + gap*scale);
    gfx_y = val_y + (th - th_u);
    gfx_drawstr(unit_str);
  ) : (
    set_font(17); gfx_a = 1; gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
    gfx_measurestr(val_str, tw, th);
    gfx_x = floor(offset_x + (x + w/2)*scale - tw/2);
    gfx_y = floor(offset_y + (y + h/2)*scale - th/2);
    gfx_drawstr(val_str);
  );
);

function header_cell(x, y, w, h, txt)
(
  gfx_a = 1; gfx_r = panel_r*1.3; gfx_g = panel_g*1.3; gfx_b = panel_b*1.3;
  gfx_rect(floor(offset_x+x*scale), floor(offset_y+y*scale), floor(w*scale), floor(h*scale), 1);
  gfx_a = 1; gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;
  gfx_rect(floor(offset_x+x*scale), floor(offset_y+y*scale), floor(w*scale), floor(h*scale), 0);
  set_font(14); gfx_a = 1; gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
  gfx_measurestr(txt, tw, th);
  gfx_x = floor(offset_x + (x+w/2)*scale - tw/2);
  gfx_y = floor(offset_y + (y+h/2)*scale - th/2);
  gfx_drawstr(txt);
);

function note_row(y, label, normal, dotted, triplet, zebra)
(
  format_time(normal);  #n1 = #out;
  format_time(dotted);  #n2 = #out;
  format_time(triplet); #n3 = #out;
  unit_name();
  cell_label(15, y, 125, 28, label, zebra);
  cell_value(140, y, 210, 28, #n1, #unit_text, zebra);
  cell_value(350, y, 210, 28, #n2, #unit_text, zebra);
  cell_value(560, y, 210, 28, #n3, #unit_text, zebra);
);

function reverb_row(y, name, pre_factor, bars, zebra)
(
  quarter = 60000/bpm;
  bar_q = cur_ts_num*4/cur_ts_den;
  bar_ms = quarter*bar_q;
  total = bar_ms*bars;
  pre = quarter*(pre_factor*4);
  decay = total - pre;

  format_time(pre);   #r1 = #out;
  format_time(decay); #r2 = #out;
  format_time(total); #r3 = #out;
  unit_name();

  bars == 4     ? (#bars_label = "4 bars")   :
  bars == 3     ? (#bars_label = "3 bars")   :
  bars == 2     ? (#bars_label = "2 bars")   :
  bars == 1     ? (#bars_label = "1 bar")    :
  bars == 0.75  ? (#bars_label = "3/4 bar")  :
  bars == 0.5   ? (#bars_label = "1/2 bar")  :
  bars == 0.375 ? (#bars_label = "3/8 bar")  :
  bars == 0.25  ? (#bars_label = "1/4 bar")  : (#bars_label = "1/8 bar");

  cell_x = 15; cell_w = 200; cell_h = 30;

  gfx_a = 1; gfx_r = panel_r*0.7; gfx_g = panel_g*0.7; gfx_b = panel_b*0.7;
  gfx_rect(floor(offset_x+cell_x*scale), floor(offset_y+y*scale), floor(cell_w*scale), floor(cell_h*scale), 1);
  zebra ? (
    gfx_a = 1; gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;
    gfx_rect(floor(offset_x+cell_x*scale), floor(offset_y+y*scale), floor(cell_w*scale), floor(cell_h*scale), 1);
  );
  gfx_a = 1; gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;
  gfx_rect(floor(offset_x+cell_x*scale), floor(offset_y+y*scale), floor(cell_w*scale), floor(cell_h*scale), 0);

  set_font(17); gfx_a = 1; gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
  gfx_measurestr(name, tw_name, th_name);
  gfx_x = floor(offset_x + (cell_x + 10) * scale);
  gfx_y = floor(offset_y + (y + cell_h/2) * scale - th_name/2);
  gfx_drawstr(name);

  set_font(12); gfx_a = 1; gfx_r = muted_r; gfx_g = muted_g; gfx_b = muted_b;
  gfx_measurestr(#bars_label, tw_bars, th_bars);
  gfx_x = floor(offset_x + (cell_x + cell_w - 10) * scale - tw_bars);
  gfx_y = floor(offset_y + (y + cell_h/2) * scale - th_bars/2);
  gfx_drawstr(#bars_label);

  cell_value(215, y, 175, cell_h, #r1, #unit_text, zebra);
  cell_value(390, y, 190, cell_h, #r2, #unit_text, zebra);
  cell_value(580, y, 190, cell_h, #r3, #unit_text, zebra);
);

function unit_button(x, y, w, h, is_active, is_hover, label)
(
  gfx_a = 1;
  is_active ? (
    gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b; draw_rrect(x, y, w, h, 8);
    gfx_r = accent_hi_r; gfx_g = accent_hi_g; gfx_b = accent_b_hi; gfx_a = 0.35;
    gfx_rect(floor(offset_x+(x+6)*scale), floor(offset_y+(y+2)*scale), floor((w-12)*scale), 1, 1);
    gfx_a = 1;
  ) : (
    is_hover ? (
      gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;
    ) : (
      gfx_r = panel_r*1.5; gfx_g = panel_g*1.5; gfx_b = panel_b*1.5;
    );
    draw_rrect(x, y, w, h, 8);
    draw_bevel(x, y, w, h, 6);
  );
  set_font(17); gfx_measurestr(label, tw, th); gfx_a = 1;
  is_active ? (gfx_r = 0.05; gfx_g = 0.05; gfx_b = 0.05;) : (gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;);
  gfx_x = floor(offset_x + (x+w/2)*scale - tw/2);
  gfx_y = floor(offset_y + (y+h/2)*scale - th/2);
  gfx_drawstr(label);
);

function ts_preset_btn(x, y, w, h, pnum, pden, pname, is_active)
(
  gfx_a = 1;
  is_active ? (
    gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b; draw_rrect(x, y, w, h, 6);
    sprintf(#ts_info, "%d/%d", pnum, pden);
    text_center_c(x, y, w, h/2, #ts_info, 18, 0.05, 0.05, 0.05);
    text_center_c(x, y+h/2, w, h/2, pname, 11, 0.05, 0.05, 0.05);
  ) : (
    gfx_r = panel_r*1.5; gfx_g = panel_g*1.5; gfx_b = panel_b*1.5; draw_rrect(x, y, w, h, 6);
    draw_bevel(x, y, w, h, 6);
    sprintf(#ts_info, "%d/%d", pnum, pden);
    text_center(x, y, w, h/2, #ts_info, 18);
    text_center(x, y+h/2, w, h/2, pname, 11);
  );
);

function find_best_note(target)
(
  fbn_q = 60000/bpm;
  fbn_best_diff = 9999999;
  fbn_best_row = 0; fbn_best_col = 0; fbn_best_ms = 0; fbn_best_mult = 0;
  fbn_idx = 0;
  while (fbn_idx < 30) (
    fbn_row = floor(fbn_idx/3);
    fbn_col = fbn_idx % 3;
    fbn_base = fbn_row == 0 ? 4 : fbn_row == 1 ? 2 : fbn_row == 2 ? 1 : fbn_row == 3 ? 0.5 :
               fbn_row == 4 ? 0.25 : fbn_row == 5 ? 0.125 : fbn_row == 6 ? 0.0625 :
               fbn_row == 7 ? 0.03125 : fbn_row == 8 ? 0.015625 : 0.0078125;
    fbn_mult = fbn_col == 0 ? 1 : fbn_col == 1 ? 1.5 : 0.6666667;
    fbn_full_mult = fbn_base*fbn_mult;
    fbn_ms = fbn_q*fbn_full_mult;
    fbn_d = abs(fbn_ms - target);
    fbn_d < fbn_best_diff ? (
      fbn_best_diff = fbn_d;
      fbn_best_row = fbn_row;
      fbn_best_col = fbn_col;
      fbn_best_ms = fbn_ms;
      fbn_best_mult = fbn_full_mult;
    );
    fbn_idx += 1;
  );
);

function build_note_name(row, col)
(
  row == 0 ? (#note_base = "1") :
  row == 1 ? (#note_base = "1/2") :
  row == 2 ? (#note_base = "1/4") :
  row == 3 ? (#note_base = "1/8") :
  row == 4 ? (#note_base = "1/16") :
  row == 5 ? (#note_base = "1/32") :
  row == 6 ? (#note_base = "1/64") :
  row == 7 ? (#note_base = "1/128") :
  row == 8 ? (#note_base = "1/256") :
             (#note_base = "1/512");
  col == 0 ? (#note_suffix = "") :
  col == 1 ? (#note_suffix = " dotted") :
             (#note_suffix = " triplet");
  strcpy(#note_name, #note_base);
  strcat(#note_name, #note_suffix);
);

function calc_feedback_tail()
(
  fb_delay_ms < 1 ? fb_delay_ms = 1;
  fb_feedback_pct < 0.1 ? fb_feedback_pct = 0.1;
  fb_feedback_pct > 99.9 ? fb_feedback_pct = 99.9;
  fb_tail_target < 0.01 ? fb_tail_target = 0.01;

  damping = fb_damping_mode == 0 ? 1.0 : fb_damping_mode == 1 ? 0.85 : 0.70;

  fb_mode == 0 ? (
    fb_factor = fb_feedback_pct/100;
    denom = 20*(log(fb_factor)/log(10));
    denom != 0 ? (
      reps_pure = fb_threshold/denom;
      reps_pure < 1 ? reps_pure = 1;
      fb_calc_repeats = reps_pure*damping;
      fb_calc_tail = (fb_calc_repeats*fb_delay_ms)/1000;
      fb_calc_feedback = fb_feedback_pct;
    );
  ) : (
    reps_target = (fb_tail_target*1000)/fb_delay_ms;
    reps_target < 1 ? reps_target = 1;
    fb_calc_repeats = reps_target;
    reps_pure = reps_target/damping;
    reps_pure < 1 ? reps_pure = 1;
    fb_factor_calc = pow(10, fb_threshold/(20*reps_pure));
    fb_calc_feedback = fb_factor_calc*100;
    fb_calc_feedback > 99.9 ? fb_calc_feedback = 99.9;
    fb_calc_tail = fb_tail_target;
  );

  fb_calc_feedback > 0.1 ? (
    fb_db_val = 20*(log(fb_calc_feedback/100)/log(10));
  ) : (
    fb_db_val = -99.9;
  );

  bar_q = cur_ts_num * 4 / cur_ts_den;
  tail_beats = (fb_calc_tail * bpm) / 60;
  bar_q > 0 ? (tail_bars = tail_beats / bar_q;) : (tail_bars = 0;);

  last_rep = floor(fb_calc_repeats);
  last_rep < 1 ? last_rep = 1;
);

@slider
sync_mode = slider3;
theme = slider4;
apply_theme();
unit = slider2;

active_tab = floor(slider5);
active_tab < 0 ? active_tab = 0;
active_tab > 2 ? active_tab = 2;

fb_threshold_idx = floor(slider6);
fb_threshold_idx < 0 ? fb_threshold_idx = 0;
fb_threshold_idx > 3 ? fb_threshold_idx = 3;
fb_threshold_idx == 0 ? fb_threshold = -40 :
fb_threshold_idx == 1 ? fb_threshold = -50 :
fb_threshold_idx == 2 ? fb_threshold = -60 : fb_threshold = -70;

!sync_mode && !edit_bpm ? (
  manual_bpm = slider1;
  bpm = slider1;
) : (
  got_slider == 0 ? (
    got_slider = 1;
    manual_bpm = slider1;
    bpm = slider1;
  );
);

fb_damping_mode = floor(slider7);
fb_damping_mode < 0 ? fb_damping_mode = 0;
fb_damping_mode > 2 ? fb_damping_mode = 2;

manual_ts_num = floor(slider8);
manual_ts_num < 1 ? manual_ts_num = 1;
manual_ts_num > 16 ? manual_ts_num = 16;

manual_ts_den = floor(slider9);
manual_ts_den < 1 ? manual_ts_den = 1;
manual_ts_den > 16 ? manual_ts_den = 16;

!sync_mode ? (
  cur_ts_num = manual_ts_num;
  cur_ts_den = manual_ts_den;
);

@block
sync_mode ? (
  tempo > 0 ? (
    bpm = tempo;
    slider1 = tempo;
  );
  ts_num > 0 && ts_denom > 0 ? (cur_ts_num = ts_num; cur_ts_den = ts_denom;);
) : (
  bpm = manual_bpm;
  cur_ts_num = manual_ts_num;
  cur_ts_den = manual_ts_den;
);

cur_ts_num < 1 ? cur_ts_num = 1;
cur_ts_num > 16 ? cur_ts_num = 16;
cur_ts_den < 1 ? cur_ts_den = 1;
cur_ts_den > 16 ? cur_ts_den = 16;
bpm < 20 ? bpm = 20;
bpm > 300 ? bpm = 300;

calc_feedback_tail();

@gfx 785 670
gfx_ext_retina = 1;
sx = gfx_w / base_w;
sy = gfx_h / base_h;
scale = sx < sy ? sx : sy;
scale < 0.2 ? scale = 0.2;
scale = floor(scale * 20) / 20;
offset_x = floor((gfx_w - base_w*scale)/2);
offset_y = floor((gfx_h - base_h*scale)/2);
mx = (mouse_x - offset_x)/scale;
my = (mouse_y - offset_y)/scale;

gfx_a = 1; gfx_r = bg_r; gfx_g = bg_g; gfx_b = bg_b;
gfx_rect(0, 0, gfx_w, gfx_h, 1);

current_time = time_precise();

just_gained_focus = (gfx_hasfocus == 1 && prev_hasfocus == 0);
just_lost_focus   = (gfx_hasfocus == 0 && prev_hasfocus == 1);
prev_hasfocus = gfx_hasfocus;

just_lost_focus ? (
  edit_bpm = 0;
  edit_ts = 0;
  fb_edit_field = 0;
  strcpy(#bpm_string, "");
  strcpy(#fb_buf, "");
);

mouse_clicked = (mouse_cap & 1) && !(last_mouse_cap & 1);
mouse_mid_clicked   = (mouse_cap & 4) && !(last_mid_cap & 4);
mouse_right_clicked = (mouse_cap & 2) && !(last_right_cap & 2);
last_mouse_cap = mouse_cap;
last_mid_cap = mouse_cap;
last_right_cap = mouse_cap;

just_gained_focus ? (focus_lockout = current_time + 0.2;);
(current_time < focus_lockout) ? (mouse_clicked = 0; mouse_mid_clicked = 0; mouse_right_clicked = 0;);

hover_sync   = (mx >= 455 && mx <= 575 && my >= 18  && my <= 48);
hover_theme  = (mx >= 585 && mx <= 690 && my >= 18  && my <= 48);
hover_help   = (mx >= 700 && mx <= 770 && my >= 18  && my <= 48);
hover_tab1   = (mx >= 15  && mx <= 260 && my >= 325 && my <= 357);
hover_tab2   = (mx >= 270 && mx <= 515 && my >= 325 && my <= 357);
hover_tab3   = (mx >= 525 && mx <= 770 && my >= 325 && my <= 357);
hover_tap    = (mx >= 400 && mx <= 770 && my >= 75  && my <= 190);
hover_ms     = (mx >= 20  && mx < 143  && my >= 255 && my <= 307);
hover_s      = (mx >= 143 && mx < 266  && my >= 255 && my <= 307);
hover_hz     = (mx >= 266 && mx <= 389 && my >= 255 && my <= 307);
hover_ts     = (mx >= 400 && mx <= 770 && my >= 255 && my <= 307);
hover_custom = (mx >= 15  && mx <= 770 && my >= 200 && my <= 248);
tap_press    = (mouse_cap & 1) && hover_tap && !sync_mode;

content_top = 354;
active_tab == 2 ? content_bottom = 900 : content_bottom = 670;
scroll_max = content_bottom - (gfx_h/scale);
scroll_max < 0 ? scroll_max = 0;
cur_wheel = mouse_wheel;
wheel_delta = cur_wheel - prev_wheel;
prev_wheel = cur_wheel;
scroll_y -= wheel_delta * 30;
scroll_y < 0 ? scroll_y = 0;
scroll_y > scroll_max ? scroll_y = scroll_max;
content_y = content_top - scroll_y;

active_tab == 0 ? (
  #str_tmp = "Reverb Size";  header_cell(15,  content_y, 200, 34, #str_tmp);
  #str_tmp = "Pre-Delay";    header_cell(215, content_y, 175, 34, #str_tmp);
  #str_tmp = "Decay Time";   header_cell(390, content_y, 190, 34, #str_tmp);
