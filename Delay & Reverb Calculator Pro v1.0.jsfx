    text_left(40, 105, #str_tmp, 16);
    help_lang == 0 ? (#str_tmp = "OVERVIEW") : (#str_tmp = "ОГЛЯД");
    text_left(40, 145, #str_tmp, 16);
    help_lang == 0 ? (
    #str_tmp = "Delay & Reverb Calculator is a tempo-based utility for calculating musical timing values for delay, reverb, and other time-based effects."; text_muted(40, 167, #str_tmp, 13);
    #str_tmp = "The calculator uses BPM and time signature to convert musical timing into exact time values."; text_muted(40, 187, #str_tmp, 13);
    #str_tmp = "It can also follow the host application tempo and time signature automatically."; text_muted(40, 207, #str_tmp, 13);
    #str_tmp = "Main sections: Reverb Suggestions, Note Durations, and Delay Tail."; text_muted(40, 227, #str_tmp, 13);
    #str_tmp = "Additional tools: Tap BPM, Custom Converter, display units, feedback scales, themes, and EN/UA Help."; text_muted(40, 247, #str_tmp, 13);
    ) : (
