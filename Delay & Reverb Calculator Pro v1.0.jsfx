    #str_tmp = "Калькулятор використовує BPM і розмір такту, щоб перетворювати музичний таймінг у точні значення часу."; text_muted(40, 187, #str_tmp, 13);
    #str_tmp = "Також він може автоматично слідувати за темпом і розміром такту хоста."; text_muted(40, 207, #str_tmp, 13);
