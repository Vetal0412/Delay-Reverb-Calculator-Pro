#str_tmp = "Note Durations";     active_tab == 1 ? text_center_c(270, 325, 245, 30, #str_tmp, 13, 0.05, 0.05, 0.05) : text_center(270, 325, 245, 30, #str_tmp, 13);
#str_tmp = "Delay Tail";         active_tab == 2 ? text_center_c(525, 325, 245, 30, #str_tmp, 13, 0.05, 0.05, 0.05) : text_center(525, 325, 245, 30, #str_tmp, 13);

(!show_ts_menu && !show_custom_menu && !show_help) ? (
  mouse_clicked && hover_tab1 ? (active_tab = 0; scroll_y = 0; slider5 = 0;);
  mouse_clicked && hover_tab2 ? (active_tab = 1; scroll_y = 0; slider5 = 1;);
  mouse_clicked && hover_tab3 ? (active_tab = 2; scroll_y = 0; slider5 = 2;);
);

show_help ? (
  hover_help_close = (mx >= 675 && mx <= 765 && my >= 35 && my <= 70);
  hover_help_lang  = (mx >= 585 && mx <= 670 && my >= 35 && my <= 70);

  mouse_clicked && hover_help_close ? (show_help = 0;);
  mouse_clicked && hover_help_lang ? (help_lang = !help_lang;);

  mouse_clicked && mx >= 35 && mx <= 125 && my >= 585 && my <= 620 ? (
    help_scroll -= 1;
    help_scroll < 0 ? help_scroll = 0;
  );

  mouse_clicked && mx >= 655 && mx <= 750 && my >= 585 && my <= 620 ? (
    help_scroll += 1;
    help_scroll > 21 ? help_scroll = 21;
  );

  mouse_wheel != help_wheel ? (
    mouse_wheel > help_wheel ? (
      help_scroll -= 1;
      help_scroll < 0 ? help_scroll = 0;
    ) : (
      help_scroll += 1;
      help_scroll > 21 ? help_scroll = 21;
    );
    help_wheel = mouse_wheel;
  );

  mouse_clicked && (mx < 15 || mx > 770 || my < 20 || my > 635) ? (show_help = 0;);
) : show_custom_menu ? (
  mouse_clicked ? ((mx < 182 || mx > 602 || my < 160 || my > 630) ? (show_custom_menu = 0;););
) : show_ts_menu ? (
  mouse_clicked ? (
    (mx >= 275 && mx <= 370 && my >= 228 && my <= 293 && !sync_mode) ? (edit_ts = 1; strcpy(#ts_num_str, ""););
    (mx >= 415 && mx <= 510 && my >= 228 && my <= 293 && !sync_mode) ? (edit_ts = 2; strcpy(#ts_den_str, ""););
    !sync_mode && mx >= 200 && mx <= 290 && my >= 368 && my <= 422 ? (manual_ts_num = 2;  manual_ts_den = 4; cur_ts_num = 2;  cur_ts_den = 4;  slider8 = 2;  slider9 = 4;  edit_ts = 0;);
    !sync_mode && mx >= 295 && mx <= 385 && my >= 368 && my <= 422 ? (manual_ts_num = 3;  manual_ts_den = 4; cur_ts_num = 3;  cur_ts_den = 4;  slider8 = 3;  slider9 = 4;  edit_ts = 0;);
    !sync_mode && mx >= 390 && mx <= 480 && my >= 368 && my <= 422 ? (manual_ts_num = 4;  manual_ts_den = 4; cur_ts_num = 4;  cur_ts_den = 4;  slider8 = 4;  slider9 = 4;  edit_ts = 0;);
    !sync_mode && mx >= 485 && mx <= 575 && my >= 368 && my <= 422 ? (manual_ts_num = 5;  manual_ts_den = 4; cur_ts_num = 5;  cur_ts_den = 4;  slider8 = 5;  slider9 = 4;  edit_ts = 0;);
    !sync_mode && mx >= 200 && mx <= 290 && my >= 432 && my <= 486 ? (manual_ts_num = 6;  manual_ts_den = 8; cur_ts_num = 6;  cur_ts_den = 8;  slider8 = 6;  slider9 = 8;  edit_ts = 0;);
    !sync_mode && mx >= 295 && mx <= 385 && my >= 432 && my <= 486 ? (manual_ts_num = 7;  manual_ts_den = 8; cur_ts_num = 7;  cur_ts_den = 8;  slider8 = 7;  slider9 = 8;  edit_ts = 0;);
    !sync_mode && mx >= 390 && mx <= 480 && my >= 432 && my <= 486 ? (manual_ts_num = 9;  manual_ts_den = 8; cur_ts_num = 9;  cur_ts_den = 8;  slider8 = 9;  slider9 = 8;  edit_ts = 0;);
    !sync_mode && mx >= 485 && mx <= 575 && my >= 432 && my <= 486 ? (manual_ts_num = 12; manual_ts_den = 8; cur_ts_num = 12; cur_ts_den = 8;  slider8 = 12; slider9 = 8;  edit_ts = 0;);
    (mx < 195 || mx > 590 || my < 160 || my > 560) ? (show_ts_menu = 0; edit_ts = 0;);
  );
) : (
  mouse_clicked && hover_sync   ? (sync_mode = !sync_mode; slider3 = sync_mode; edit_bpm = 0;);
  mouse_clicked && hover_theme  ? (theme += 1; theme > 3 ? theme = 0; slider4 = theme; apply_theme(););
  mouse_clicked && hover_help   ? (show_help = 1; help_scroll = 0; help_wheel = mouse_wheel;);
  mouse_clicked && hover_custom ? (show_custom_menu = 1; strcpy(#custom_string, ""););
  mouse_clicked && (mx < 35 || mx > 365 || my < 115 || my > 160) ? (edit_bpm = 0; strcpy(#bpm_string, ""););
  mouse_clicked && my >= 255 && my <= 317 ? (
    mx >= 25  && mx < 143  ? (unit = 0; slider2 = 0;);
    mx >= 143 && mx < 266  ? (unit = 1; slider2 = 1;);
    mx >= 266 && mx <= 389 ? (unit = 2; slider2 = 2;);
  );
  mouse_clicked && hover_ts ? (show_ts_menu = 1; edit_ts = 0;);
  mouse_clicked && !sync_mode && mx >= 35 && mx <= 365 && my >= 115 && my <= 160 ? (edit_bpm = 1; strcpy(#bpm_string, ""););

  (mouse_mid_clicked || mouse_right_clicked) && hover_tap && !sync_mode ? (
    tap_n = 0;
    tap_i0 = 0; tap_i1 = 0; tap_i2 = 0; tap_i3 = 0; tap_i4 = 0; tap_i5 = 0;
    tap_last = 0;
  );

  mouse_clicked && !sync_mode && mx >= 400 && mx <= 770 && my >= 75 && my <= 190 ? (
    now = time_precise();
    tap_last > 0 && now - tap_last > 2.0 ? (
      tap_n = 0; tap_i0 = 0; tap_i1 = 0; tap_i2 = 0; tap_i3 = 0; tap_i4 = 0; tap_i5 = 0;
    );
    tap_last > 0 ? (
      interval = now - tap_last;
      interval > 0.1 && interval < 2.0 ? (
        tap_i5 = tap_i4; tap_i4 = tap_i3; tap_i3 = tap_i2;
        tap_i2 = tap_i1; tap_i1 = tap_i0; tap_i0 = interval;
        tap_n += 1;
        tap_n > 6 ? tap_n = 6;
        tsum = 0;
        tap_n >= 1 ? tsum += tap_i0;
        tap_n >= 2 ? tsum += tap_i1;
        tap_n >= 3 ? tsum += tap_i2;
        tap_n >= 4 ? tsum += tap_i3;
        tap_n >= 5 ? tsum += tap_i4;
        tap_n >= 6 ? tsum += tap_i5;
        avg = tsum / tap_n;
        avg > 0 ? (
          bpm = 60/avg;
          bpm < 20 ? bpm = 20;
          bpm > 300 ? bpm = 300;
          manual_bpm = bpm;
          slider1 = bpm;
        );
      );
    );
    tap_last = now;
  );

  active_tab == 2 ? (
    mouse_clicked && hover_fb_mode0 ? (fb_mode = 0; fb_edit_field = 0; strcpy(#fb_buf, ""););
    mouse_clicked && hover_fb_mode1 ? (fb_mode = 1; fb_edit_field = 0; strcpy(#fb_buf, ""););
    mouse_clicked && hover_thr40    ? (fb_threshold = -40; fb_threshold_idx = 0; slider6 = 0;);
    mouse_clicked && hover_thr50    ? (fb_threshold = -50; fb_threshold_idx = 1; slider6 = 1;);
    mouse_clicked && hover_thr60    ? (fb_threshold = -60; fb_threshold_idx = 2; slider6 = 2;);
    mouse_clicked && hover_thr70    ? (fb_threshold = -70; fb_threshold_idx = 3; slider6 = 3;);
    mouse_clicked && hover_dmp0     ? (fb_damping_mode = 0; slider7 = 0;);
    mouse_clicked && hover_dmp1     ? (fb_damping_mode = 1; slider7 = 1;);
    mouse_clicked && hover_dmp2     ? (fb_damping_mode = 2; slider7 = 2;);
    mouse_clicked && hover_fb_delay ? (fb_edit_field = 1; strcpy(#fb_buf, ""););
    mouse_clicked && hover_fb_input ? (
      fb_mode == 0 ? (fb_edit_field = 2; strcpy(#fb_buf, "");) : (fb_edit_field = 3; strcpy(#fb_buf, ""););
    );
  );
);

