  #str_tmp = "Common";       ts_preset_btn(390, 368, 90, 54, 4,  4, #str_tmp, cur_ts_num == 4  && cur_ts_den == 4);
  #str_tmp = "Five Four";    ts_preset_btn(485, 368, 90, 54, 5,  4, #str_tmp, cur_ts_num == 5  && cur_ts_den == 4);
  #str_tmp = "Six Eight";    ts_preset_btn(200, 432, 90, 54, 6,  8, #str_tmp, cur_ts_num == 6  && cur_ts_den == 8);
  #str_tmp = "Seven Eight";  ts_preset_btn(295, 432, 90, 54, 7,  8, #str_tmp, cur_ts_num == 7  && cur_ts_den == 8);
  #str_tmp = "Nine Eight";   ts_preset_btn(390, 432, 90, 54, 9,  8, #str_tmp, cur_ts_num == 9  && cur_ts_den == 8);
  #str_tmp = "Twelve Eight"; ts_preset_btn(485, 432, 90, 54, 12, 8, #str_tmp, cur_ts_num == 12 && cur_ts_den == 8);

  gfx_a = 1; gfx_r = muted_r; gfx_g = muted_g; gfx_b = muted_b;
  set_font(10);
  gfx_measurestr("ENTER to close  -  ESC to cancel", tw, th);
  gfx_x = floor(offset_x+(195+395/2)*scale - tw/2);
  gfx_y = floor(offset_y+538*scale);
  gfx_drawstr("ENTER to close  -  ESC to cancel");
);

show_custom_menu ? (
  gfx_a = 0.7; gfx_r = 0; gfx_g = 0; gfx_b = 0;
  gfx_rect(0, 0, gfx_w, gfx_h, 1);
  gfx_a = 1;
  panel(182, 160, 420, 470);
  #str_tmp = "CUSTOM CONVERTER"; text_center(182, 175, 420, 30, #str_tmp, 14);

  gfx_a = 0.4; gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;
  gfx_rect(floor(offset_x+212*scale), floor(offset_y+208*scale), floor(360*scale), 1, 1);
  gfx_a = 1;

  gfx_a = 0.3; gfx_r = 0; gfx_g = 0; gfx_b = 0; draw_rrect(212, 220, 360, 55, 8);
  gfx_a = 1; gfx_r = panel_r*1.2; gfx_g = panel_g*1.2; gfx_b = panel_b*1.2; draw_rrect(212, 222, 360, 51, 8);

  strlen(#custom_string) > 0 ? (
    gfx_a = 1; gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;
    set_font(24); gfx_x = floor(offset_x+232*scale); gfx_y = floor(offset_y+234*scale);
    gfx_drawstr(#custom_string);
    gfx_measurestr(#custom_string, tw, th);
    cur_on = ((floor(time_precise()*2)) % 2) == 0;
    cur_on ? (
      gfx_a = 1; gfx_r = accent_hi_r; gfx_g = accent_hi_g; gfx_b = accent_b_hi;
      gfx_rect(floor(offset_x+232*scale+tw+2*scale), floor(offset_y+234*scale), 2, floor(28*scale), 1);
    );
  ) : (
    gfx_a = 1; gfx_r = muted_r; gfx_g = muted_g; gfx_b = muted_b;
    set_font(24); gfx_x = floor(offset_x+232*scale); gfx_y = floor(offset_y+234*scale);
    gfx_drawstr("_ _ _");
  );

  gfx_a = 1; gfx_r = muted_r; gfx_g = muted_g; gfx_b = muted_b;
  set_font(16); gfx_x = floor(offset_x+532*scale); gfx_y = floor(offset_y+240*scale);
  gfx_drawstr("ms");

  custom_ms = 0;
  strlen(#custom_string) > 0 ? match("%f", #custom_string, custom_ms);

  custom_ms > 0.5 && custom_ms < 10000 ? (
    find_best_note(custom_ms);
    build_note_name(fbn_best_row, fbn_best_col);

    gfx_a = 1; gfx_r = muted_r; gfx_g = muted_g; gfx_b = muted_b;
    set_font(11); gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+290*scale);
    gfx_drawstr("CLOSEST MATCH");

    gfx_a = 1; gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;
    set_font(22); gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+312*scale);
    gfx_drawstr(#note_name);

    sprintf(#out, "%.2f ms @ %.2f BPM", fbn_best_ms, bpm);
    gfx_a = 1; gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
    set_font(13); gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+348*scale);
    gfx_drawstr(#out);

    err_pct = (custom_ms - fbn_best_ms) / fbn_best_ms * 100;
    abs(err_pct) < 0.05 ? (
      sprintf(#out, "Error: 0.0%%  exact match");
    ) : (
      err_pct > 0 ? sprintf(#out, "Error: +%.1f%% (your value is longer)", err_pct) :
                    sprintf(#out, "Error: %.1f%% (your value is shorter)", err_pct);
    );
    gfx_a = 1; gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
    set_font(13); gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+370*scale);
    gfx_drawstr(#out);

    gfx_a = 1; gfx_r = muted_r; gfx_g = muted_g; gfx_b = muted_b;
    set_font(11); gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+398*scale);
    gfx_drawstr("EXACT BPM FOR THIS NOTE VALUE");

    exact_bpm = 60000 * fbn_best_mult / custom_ms;
    sprintf(#out, "%.2f", exact_bpm);
    gfx_a = 1; gfx_r = accent_hi_r; gfx_g = accent_hi_g; gfx_b = accent_b_hi;
    set_font(22); gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+416*scale);
    gfx_drawstr(#out);

    gfx_a = 0.4; gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;
    gfx_rect(floor(offset_x+212*scale), floor(offset_y+450*scale), floor(360*scale), 1, 1);
    gfx_a = 1;

    gfx_a = 1; gfx_r = muted_r; gfx_g = muted_g; gfx_b = muted_b;
    set_font(11); gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+460*scale);
    gfx_drawstr("EFFECT TIME");

    gfx_a = 1; gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
    set_font(13); gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+476*scale);
    gfx_drawstr(#note_name);
    gfx_measurestr(#note_name, tw1, th1);
    gfx_x = floor(offset_x+212*scale + tw1);
    gfx_drawstr(" @ ");
    gfx_measurestr(" @ ", tw2, th2);
    gfx_x = floor(offset_x+212*scale + tw1 + tw2);
    sprintf(#out, "%.2f BPM", bpm);
    gfx_drawstr(#out);

    gfx_a = 1; gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;
    set_font(22); gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+494*scale);
    sprintf(#out, "%.2f ms", fbn_best_ms);
    gfx_drawstr(#out);

    gfx_a = 1; gfx_r = muted_r; gfx_g = muted_g; gfx_b = muted_b;
    set_font(11); gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+526*scale);
    gfx_drawstr("Useful for:");

    gfx_a = 1; gfx_r = text_r; gfx_g = text_g; gfx_b = text_b;
    set_font(12); gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+545*scale);
    gfx_drawstr("Reverb Tail / Decay (suggested)");
    sprintf(#out, "%.2f ms", fbn_best_ms*4);
    gfx_measurestr(#out, tw, th);
    gfx_x = floor(offset_x+560*scale - tw);
    gfx_drawstr(#out);

    gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+562*scale);
    gfx_drawstr("Delay Time");
    sprintf(#out, "%.2f ms", fbn_best_ms);
    gfx_measurestr(#out, tw, th);
    gfx_x = floor(offset_x+560*scale - tw);
    gfx_drawstr(#out);

    gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+579*scale);
    gfx_drawstr("Ducking Release (suggested)");
    sprintf(#out, "%.2f ms", fbn_best_ms*2);
    gfx_measurestr(#out, tw, th);
    gfx_x = floor(offset_x+560*scale - tw);
    gfx_drawstr(#out);
  ) : (
    gfx_a = 1; gfx_r = muted_r; gfx_g = muted_g; gfx_b = muted_b;
    set_font(14); gfx_x = floor(offset_x+212*scale); gfx_y = floor(offset_y+310*scale);
    gfx_drawstr("Type a value in milliseconds...");
  );

  gfx_a = 1; gfx_r = muted_r; gfx_g = muted_g; gfx_b = muted_b;
  set_font(10);
  gfx_measurestr("ENTER to close  -  ESC to cancel", tw, th);
  gfx_x = floor(offset_x+(182+420/2)*scale - tw/2);
  gfx_y = floor(offset_y+608*scale);
  gfx_drawstr("ENTER to close  -  ESC to cancel");
);