  hover_fb_mode1 = (my >= 354) && (mx >= 210 && mx <= 375 && my >= content_y+98 && my <= content_y+124);

  fb_mode == 0 ? (gfx_r = accent_r; gfx_g = accent_g; gfx_b = accent_b;) :
                 (hover_fb_mode0 ? (gfx_r = line_r; gfx_g = line_g; gfx_b = line_b;) : (gfx_r = panel_r*1.3; gfx_g = panel_g*1.3; gfx_b = panel_b*1.3;));
  draw_rrect(35, content_y+98, 165, 26, 6);
  fb_mode == 0 ? (gfx_r = accent_hi_r; gfx_g = accent_hi_g; gfx_b = accent_b_hi; gfx_a = 0.35;
