  gfx_a = 0.4; gfx_r = line_r; gfx_g = line_g; gfx_b = line_b; gfx_rect(floor(offset_x+30*scale), floor(offset_y+78*scale), floor(725*scale), 1, 1); gfx_a = 1;
  help_scroll == 0 ? (
