    #str_tmp = "Hz = reciprocal frequency representation of the interval. Frequency = 1000 / milliseconds."; text_muted(40, 347, #str_tmp, 13);
    #str_tmp = "Example: 500 ms = 2 Hz."; text_muted(40, 367, #str_tmp, 13);
