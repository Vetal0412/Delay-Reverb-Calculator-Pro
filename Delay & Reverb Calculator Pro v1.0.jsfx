    #str_tmp = "Manual зручний для незалежних розрахунків, експериментів або роботи без DAW."; text_muted(40, 347, #str_tmp, 13);
    #str_tmp = "Sync слідує за темпом хоста. У Sync керування BPM блокується."; text_muted(40, 367, #str_tmp, 13);
    #str_tmp = "Якщо хост надає коректний розмір такту, він також використовується. Зміна темпу проєкту автоматично оновлює калькулятор."; text_muted(40, 387, #str_tmp, 13);
    #str_tmp = "Якщо хост не дає коректного темпу, калькулятор зберігає допустимий BPM."; text_muted(40, 407, #str_tmp, 13);
