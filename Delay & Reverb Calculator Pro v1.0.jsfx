    #str_tmp = "Для середнього використовується до шести останніх інтервалів."; text_muted(40, 207, #str_tmp, 13);
    #str_tmp = "Якщо між натисканнями минає більше двох секунд, поточна серія починається заново."; text_muted(40, 227, #str_tmp, 13);
    #str_tmp = "Інтервали поза допустимим діапазоном ігноруються."; text_muted(40, 247, #str_tmp, 13);
    #str_tmp = "Середня або права кнопка миші на TAP BPM скидає лічильник."; text_muted(40, 267, #str_tmp, 13);
    );
    help_lang == 0 ? (#str_tmp = "MANUAL / SYNC") : (#str_tmp = "MANUAL / SYNC");
    text_left(40, 305, #str_tmp, 16);
    help_lang == 0 ? (
    #str_tmp = "Manual uses the BPM and time signature entered by the user."; text_muted(40, 327, #str_tmp, 13);
    #str_tmp = "Use Manual for independent calculations, experimentation, or work outside a DAW project."; text_muted(40, 347, #str_tmp, 13);
    #str_tmp = "Sync follows the host application tempo. The BPM control is locked while Sync is active."; text_muted(40, 367, #str_tmp, 13);
    #str_tmp = "When available, the host time signature is also used. Changing project tempo updates the calculator automatically."; text_muted(40, 387, #str_tmp, 13);
